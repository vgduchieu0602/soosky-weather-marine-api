{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "numericString": {
      "type": "string",
      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
    },
    "measurement": {
      "oneOf": [
        {"type": "number"},
        {"$ref": "#/$defs/numericString"},
        {"type": "string", "enum": ["n/a", "N/A"]}
      ],
      "description": "A measurement as a number, a numeric string, or the placeholder n/a when the source reports it unavailable."
    },
    "nullableMeasurement": {
      "oneOf": [
        {"type": "number"},
        {"$ref": "#/$defs/numericString"},
        {"type": "string", "enum": ["n/a", "N/A"]},
        {"type": "null"}
      ],
      "description": "Same as measurement, plus null when the field is absent upstream."
    }
  },
  "required": ["persona", "weather"],
  "properties": {
    "persona": {
      "type": "string",
      "enum": ["Traveler", "Water Sports", "Coastal Captain", "Offshore Fishing", "Other"]
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature", "windSpeed", "windDirection", "gust", "waveHeight", "waterTemp",
        "atmospherePressure", "updatedAt", "visibility", "uvIndex", "humidity", "tideChart"
      ],
      "properties": {
        "temperature": {"$ref": "#/$defs/measurement", "description": "°C"},
        "windSpeed": {"$ref": "#/$defs/measurement", "description": "Use the supplied unit without conversion."},
        "windDirection": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 360}, {"type": "string"}]},
        "gust": {"$ref": "#/$defs/measurement"},
        "waveHeight": {"$ref": "#/$defs/nullableMeasurement", "description": "meters"},
        "waterTemp": {"$ref": "#/$defs/nullableMeasurement", "description": "°C"},
        "atmospherePressure": {"$ref": "#/$defs/measurement"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "visibility": {
          "$ref": "#/$defs/nullableMeasurement",
          "description": "Visibility measurement, or n/a when the source reports it unavailable."
        },
        "uvIndex": {"$ref": "#/$defs/measurement"},
        "humidity": {"$ref": "#/$defs/nullableMeasurement"},
        "tideChart": {
          "oneOf": [
            {"type": "null", "description": "No tide prediction is available for this location."},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["stationId", "predictions"],
              "properties": {
                "stationId": {"type": "string", "minLength": 1},
                "predictions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["time", "height"],
                    "properties": {
                      "time": {"type": "string", "format": "date-time"},
                      "height": {
                        "oneOf": [
                          {"type": "number"},
                          {"type": "string", "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"}
                        ],
                        "description": "meters; numeric strings from tide sources are accepted."
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
