# Cổng và host cho server
HTTP_PORT=3001
HTTP_HOST=0.0.0.0

# Kết nối MongoDB (sẽ dùng ở bước sau)
MONGODB_URI=

# API keys các provider (điền ở bước sau, để trống lúc này cũng được)
OWM_API_KEY=
WEATHERBIT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash

# Giới hạn request (chống spam)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120