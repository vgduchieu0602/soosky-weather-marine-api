# Cổng và host cho server
PORT=3002
NODE_ENV=development

# Kết nối MongoDB
MONGO_URI=
MONGO_MAX_POOL_SIZE=5

# NDBC buoy station sync worker
NDBC_ACTIVE_STATIONS_URL=https://www.ndbc.noaa.gov/activestations.xml
NDBC_FETCH_TIMEOUT_MS=20000
NDBC_FETCH_RETRIES=3
BUOY_SYNC_INTERVAL_MS=86400000
BUOY_SYNC_RUN_ON_BOOT=true

# API keys các provider
OWM_API_KEY=
# free-3h (default): 5 day / 3 hour, free tier; daily is aggregated from the 3-hour steps.
# pro-hourly: Hourly Forecast 4 days + Daily Forecast 16 days (cnt=5) — BOTH are
#   separate paid products; an unsubscribed key returns HTTP 401 on both.
OWM_FORECAST_SOURCE=free-3h
# Safety switch: OWM map tiles can generate a high number of paid requests.
# Set true only when map layers are intentionally enabled.
MAP_TILES_ENABLED=false

WEATHERBIT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite


# Giới hạn request
# RATE_LIMIT_ENABLED=false  # đặt 'false' để tắt rate limit (test); mặc định bật
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120   # trần tổng mọi IP cộng lại (endpoint data)
RATE_LIMIT_IP_MAX=60        # trần mỗi IP (endpoint data)
# Bucket riêng cho /api/v1/maps/* — tile map bùng nổ theo lô, hạn cao hơn
RATE_LIMIT_MAP_GLOBAL_MAX=1200
RATE_LIMIT_MAP_IP_MAX=600
