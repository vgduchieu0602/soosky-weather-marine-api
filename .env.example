# Cổng và host cho server
PORT=3002
NODE_ENV=development

# Kết nối MongoDB
MONGO_URI=
MONGO_MAX_POOL_SIZE=5

# NDBC buoy station sync worker
NDBC_ACTIVE_STATIONS_URL=https://www.ndbc.noaa.gov/activestations.xml
NDBC_FETCH_TIMEOUT_MS=20000
NDBC_FETCH_RETRIES=3

SYNC_INTERVAL_MS=86400000
SYNC_RUN_ON_BOOT=true

# API keys các provider
OWM_API_KEY=
OWM_FORECAST_SOURCE=free-3h

# Safety switch: OWM map tiles can generate a high number of paid requests.
# Set true only when map layers are intentionally enabled.
MAP_TILES_ENABLED=false

WEATHERBIT_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Giới hạn request — chỉ per-IP, áp cho mọi endpoint TRỪ /api/v1/maps/* (tile map
# bùng nổ theo lô nên được miễn; trần chi phí OWM dựa vào MAP_TILES_ENABLED + LRU cache).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=60        # trần mỗi IP trong 1 cửa sổ
