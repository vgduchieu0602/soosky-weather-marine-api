# Cổng và host cho server
PORT=3002
NODE_ENV=development

# Kết nối MongoDB
MONGO_URI=

# API keys các provider
OWM_API_KEY=
WEATHERBIT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite


# Giới hạn request
# RATE_LIMIT_ENABLED=false  # đặt 'false' để tắt rate limit (test); mặc định bật
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120   # trần tổng mọi IP cộng lại (endpoint data)
RATE_LIMIT_IP_MAX=60        # trần mỗi IP (endpoint data)
# Bucket riêng cho /api/v1/maps/* — tile map bùng nổ theo lô, hạn cao hơn
RATE_LIMIT_MAP_GLOBAL_MAX=1200
RATE_LIMIT_MAP_IP_MAX=600
